# Copy to .env to change settings. All are optional.
PORT=8000
# Detector service address (detector/app.py listens on 127.0.0.1:8001)
DETECTOR_URL=http://127.0.0.1:8001
# Set to false before the database is first created to start with no demo cases
SEED_DEMO=true
MAX_UPLOAD_MB=8
SESSION_HOURS=12
# Detector tuning (read by detector/app.py)
# DETECT_CONF=0.25
# MODEL_PATH=detector/models/pothole.pt
